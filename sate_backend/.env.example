# ============================================================
# SATE — variáveis de ambiente do backend (copie para .env e preencha)
# NUNCA envie o arquivo .env real para o Git nem compartilhe.
# ============================================================

# Conexão com o MySQL (mesmo banco usado pelo site)
DATABASE_URL="mysql://USUARIO:SENHA@localhost:3306/NOME_DO_BANCO"

# Segredo usado para assinar os tokens JWT (use um texto longo e aleatório)
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Porta do servidor (padrão 3000)
PORT=3000

# --- Aplicativo mobile ---------------------------------------
# Se o site usa Cloudflare Turnstile (TURNSTILE_SECRET_KEY), o app não consegue
# resolver o captcha do navegador. Defina uma chave e use o MESMO valor no app
# (flutter run --dart-define=MOBILE_APP_KEY=...). Sem esta variável o bypass fica desativado.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MOBILE_APP_KEY=

# --- Já usadas pelo backend (preencha só o que você utiliza) ---
# URL do site (links de e-mail de verificação/recuperação de senha)
# FRONTEND_URL=http://localhost:5173

# Envio de e-mails (verificação de conta e recuperação de senha)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Cloudflare Turnstile (captcha do site). Sem a chave secreta, o captcha fica desligado.
# TURNSTILE_SECRET_KEY=
# TURNSTILE_ALLOWED_HOSTNAMES=
