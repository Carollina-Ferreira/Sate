generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id             Int          @id @default(autoincrement())
  email          String       @unique
  senha          String
  tipo           TipoUsuario?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  nome           String?
  avatarUrl      String?      @db.LongText
  primeiroAcesso Boolean      @default(true)

  atleta              Atleta?
  treinador           Treinador?
  passwordResetTokens PasswordResetToken[]
}

model Treinador {
  id        Int      @id @default(autoincrement())
  nome      String
  usuarioId Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuario              Usuario               @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  equipes              Equipe[]
  atletas              Atleta[]
  configuracoesAnalise ConfiguracaoAnalise[]

  @@index([usuarioId])
}

model ConfiguracaoAnalise {
  id          Int               @id @default(autoincrement())
  nome        String
  descricao   String?
  tipo        TipoEventoAnalise @default(POSITIVA)
  ordem       Int               @default(0)
  treinadorId Int
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  treinador Treinador @relation(fields: [treinadorId], references: [id], onDelete: Cascade)

  @@index([treinadorId])
  @@index([treinadorId, ordem])
}

model Atleta {
  id             Int       @id @default(autoincrement())
  nome           String?
  cpf            String?   @unique
  rg             String?
  dataNascimento DateTime?
  sexo           Sexo?
  categoria      String?
  telefone       String?
  usuarioId      Int       @unique
  responsavelId  Int?      @unique
  enderecoId     Int?      @unique
  equipeId       Int?
  treinadorId    Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  endereco       Endereco?        @relation(fields: [enderecoId], references: [id])
  responsavel    Responsavel?     @relation(fields: [responsavelId], references: [id])
  usuario        Usuario          @relation(fields: [usuarioId], references: [id])
  equipe         Equipe?          @relation(fields: [equipeId], references: [id], onDelete: SetNull)
  treinador      Treinador?       @relation(fields: [treinadorId], references: [id], onDelete: SetNull)
  documentos     Documento[]
  marcacoesVideo MarcacaoVideo[]

  @@index([equipeId])
  @@index([treinadorId])
}

model Equipe {
  id             Int       @id @default(autoincrement())
  nome           String
  modalidade     String
  categoria      String?
  proximaPartida DateTime?
  imagem         String?   @db.LongText
  corEquipe      String?
  treinadorId    Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  treinador Treinador @relation(fields: [treinadorId], references: [id], onDelete: Cascade)
  atletas   Atleta[]
  partidas  Partida[]

  @@index([treinadorId], map: "Equipe_treinadorId_fkey")
}

model Partida {
  id             Int           @id @default(autoincrement())
  equipeId       Int
  adversario     String
  data           DateTime
  local          String?
  campeonato     String?
  rodada         String?
  observacoes    String?
  status         StatusPartida @default(AGENDADA)
  golsEquipe     Int?
  golsAdversario Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  equipe Equipe         @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  videos VideoPartida[]

  @@index([equipeId], map: "Partida_equipeId_fkey")
  @@index([data])
}

model VideoPartida {
  id          Int      @id @default(autoincrement())
  partidaId   Int
  titulo      String
  nomeArquivo String
  url         String
  tipo        String?
  tamanho     Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  partida   Partida         @relation(fields: [partidaId], references: [id], onDelete: Cascade)
  marcacoes MarcacaoVideo[]

  @@index([partidaId], map: "VideoPartida_partidaId_fkey")
}

model MarcacaoVideo {
  id          Int      @id @default(autoincrement())
  videoId     Int
  atletaId    Int?
  titulo      String
  categoria   String
  tempoInicio Float
  tempoFim    Float
  observacao  String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  video  VideoPartida @relation(fields: [videoId], references: [id], onDelete: Cascade)
  atleta Atleta?      @relation(fields: [atletaId], references: [id], onDelete: SetNull)

  @@index([videoId])
  @@index([videoId, tempoInicio])
  @@index([atletaId])
}

model Responsavel {
  id             Int      @id @default(autoincrement())
  nome           String
  grauParentesco String
  telefone       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  atleta Atleta?
}

model Endereco {
  id          Int      @id @default(autoincrement())
  cep         String
  logradouro  String
  numero      String
  bairro      String
  complemento String?
  cidade      String?
  estado      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  atleta Atleta?
}

model Documento {
  id        Int      @id @default(autoincrement())
  nome      String
  tipo      String
  url       String
  atletaId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  atleta Atleta @relation(fields: [atletaId], references: [id], onDelete: Cascade)

  @@index([atletaId], map: "Documento_atletaId_fkey")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  usuarioId Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

enum TipoUsuario {
  TREINADOR
  ATLETA
}

enum Sexo {
  MASCULINO
  FEMININO
  OUTRO
  NAO_INFORMADO
}

enum StatusPartida {
  AGENDADA
  EM_ANDAMENTO
  FINALIZADA
  CANCELADA
}

enum TipoEventoAnalise {
  POSITIVA
  NEGATIVA
  NEUTRA
}
