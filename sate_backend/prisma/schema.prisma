generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USUÁRIO
// ============================================================

model Usuario {
  id             Int          @id @default(autoincrement())
  email          String       @unique
  senha          String
  tipo           TipoUsuario?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  nome           String?
  avatarUrl      String?      @db.LongText
  primeiroAcesso Boolean      @default(true)

  // Preserva contas existentes como verificadas.
  // O cadastro de novos usuários deve definir false explicitamente.
  emailVerificado Boolean @default(true)

  atleta                  Atleta?
  treinador               Treinador?
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
}

// ============================================================
// TREINADOR
// ============================================================

model Treinador {
  id        Int      @id @default(autoincrement())
  nome      String
  usuarioId Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuario              Usuario               @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  equipes              Equipe[]
  atletas              Atleta[]
  configuracoesAnalise ConfiguracaoAnalise[]
  notificacoes         Notificacao[]
  marcacoes            MarcacaoVideo[]

  @@index([usuarioId])
}

// ============================================================
// NOTIFICAÇÕES
// ============================================================

model Notificacao {
  id           Int       @id @default(autoincrement())
  treinadorId  Int
  tipo         String
  titulo       String
  descricao    String    @db.Text
  link         String?
  chave        String
  lida         Boolean   @default(false)
  entidadeTipo String?
  entidadeId   Int?
  resolvidaEm  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  treinador Treinador @relation(fields: [treinadorId], references: [id], onDelete: Cascade)

  @@unique([treinadorId, chave])
  @@index([treinadorId, lida, createdAt])
  @@index([treinadorId, resolvidaEm])
}

// ============================================================
// CONFIGURAÇÕES DE ANÁLISE
// ============================================================

model ConfiguracaoAnalise {
  id                Int               @id @default(autoincrement())
  nome              String
  descricao         String?
  tipo              TipoEventoAnalise @default(POSITIVA)
  ordem             Int               @default(0)
  treinadorId       Int
  equipeId          Int?
  icone             String?
  cor               String?
  mostrarNaTimeline Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  treinador Treinador @relation(fields: [treinadorId], references: [id], onDelete: Cascade)
  equipe    Equipe?   @relation(fields: [equipeId], references: [id], onDelete: Cascade)

  marcacoes MarcacaoVideo[]

  @@index([treinadorId])
  @@index([treinadorId, ordem])
  @@index([equipeId])
}

// ============================================================
// ATLETA
// ============================================================

model Atleta {
  id             Int       @id @default(autoincrement())
  nome           String?
  cpf            String?   @unique
  rg             String?
  dataNascimento DateTime?
  sexo           Sexo?
  categoria      String?
  telefone       String?
  usuarioId      Int       @unique
  responsavelId  Int?      @unique
  enderecoId     Int?      @unique
  equipeId       Int?
  treinadorId    Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  usuario     Usuario      @relation(fields: [usuarioId], references: [id])
  responsavel Responsavel? @relation(fields: [responsavelId], references: [id])
  endereco    Endereco?    @relation(fields: [enderecoId], references: [id])
  equipe      Equipe?      @relation(fields: [equipeId], references: [id], onDelete: SetNull)
  treinador   Treinador?   @relation(fields: [treinadorId], references: [id], onDelete: SetNull)

  documentos Documento[]

  // Partidas em que o atleta foi escalado.
  partidas PartidaAtleta[]

  // Marcações de vídeo associadas ao atleta.
  marcacoes MarcacaoVideo[]

  @@index([equipeId])
  @@index([treinadorId])
}

// ============================================================
// EQUIPE
// ============================================================

model Equipe {
  id             Int       @id @default(autoincrement())
  nome           String
  modalidade     String
  categoria      String?
  proximaPartida DateTime?
  imagem         String?   @db.LongText
  corEquipe      String?
  treinadorId    Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  treinador Treinador @relation(fields: [treinadorId], references: [id], onDelete: Cascade)

  atletas              Atleta[]
  partidas             Partida[]
  configuracoesAnalise ConfiguracaoAnalise[]

  @@index([treinadorId], map: "Equipe_treinadorId_fkey")
}

// ============================================================
// PARTIDA
// ============================================================

model Partida {
  id             Int           @id @default(autoincrement())
  equipeId       Int
  adversario     String
  data           DateTime
  local          String?
  campeonato     String?
  rodada         String?
  observacoes    String?
  status         StatusPartida @default(AGENDADA)
  golsEquipe     Int?
  golsAdversario Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  equipe  Equipe          @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  videos  VideoPartida[]
  atletas PartidaAtleta[]

  @@index([equipeId], map: "Partida_equipeId_fkey")
  @@index([data])
}

// ============================================================
// ATLETAS ESCALADOS NA PARTIDA
// ============================================================

model PartidaAtleta {
  id        Int      @id @default(autoincrement())
  partidaId Int
  atletaId  Int
  createdAt DateTime @default(now())

  partida Partida @relation(fields: [partidaId], references: [id], onDelete: Cascade)
  atleta  Atleta  @relation(fields: [atletaId], references: [id], onDelete: Cascade)

  // Impede cadastrar o mesmo atleta duas vezes na mesma partida.
  @@unique([partidaId, atletaId])
  @@index([atletaId])
}

// ============================================================
// VÍDEOS DAS PARTIDAS
// ============================================================

model VideoPartida {
  id          Int      @id @default(autoincrement())
  partidaId   Int
  titulo      String
  nomeArquivo String
  url         String
  tipo        String?
  tamanho     Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  partida   Partida         @relation(fields: [partidaId], references: [id], onDelete: Cascade)
  marcacoes MarcacaoVideo[]
  anotacoes AnotacaoVideo[]

  @@index([partidaId], map: "VideoPartida_partidaId_fkey")
}

// ============================================================
// MARCAÇÕES DE VÍDEO
// ============================================================

model MarcacaoVideo {
  id           Int                @id @default(autoincrement())
  videoId      Int
  atletaId     Int?
  titulo       String
  categoria    String
  tempoInicio  Float
  tempoFim     Float
  observacao   String?            @db.Text
  treinadorId  Int?
  categoriaId  Int?
  avaliacao    TipoEventoAnalise?
  tipoRegistro String             @default("EVENTO")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  video        VideoPartida         @relation(fields: [videoId], references: [id], onDelete: Cascade)
  atleta       Atleta?              @relation(fields: [atletaId], references: [id], onDelete: SetNull)
  treinador    Treinador?           @relation(fields: [treinadorId], references: [id], onDelete: SetNull)
  configuracao ConfiguracaoAnalise? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)

  @@index([videoId])
  @@index([videoId, tempoInicio])
  @@index([atletaId])
  @@index([treinadorId])
  @@index([categoriaId])
}

// ============================================================
// ANOTAÇÕES E DESENHOS SOBRE VÍDEOS
// ============================================================

model AnotacaoVideo {
  id        Int      @id @default(autoincrement())
  videoId   Int
  tempo     Float
  duracao   Float    @default(5)
  formas    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  video VideoPartida @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, tempo])
}

// ============================================================
// RESPONSÁVEL DO ATLETA
// ============================================================

model Responsavel {
  id             Int      @id @default(autoincrement())
  nome           String
  grauParentesco String
  telefone       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  atleta Atleta?
}

// ============================================================
// ENDEREÇO
// ============================================================

model Endereco {
  id          Int      @id @default(autoincrement())
  cep         String
  logradouro  String
  numero      String
  bairro      String
  complemento String?
  cidade      String?
  estado      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  atleta Atleta?
}

// ============================================================
// DOCUMENTOS DO ATLETA
// ============================================================

model Documento {
  id        Int      @id @default(autoincrement())
  nome      String
  tipo      String
  url       String
  atletaId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  atleta Atleta @relation(fields: [atletaId], references: [id], onDelete: Cascade)

  @@index([atletaId], map: "Documento_atletaId_fkey")
}

// ============================================================
// RECUPERAÇÃO DE SENHA
// ============================================================

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  usuarioId Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

// ============================================================
// VERIFICAÇÃO DE E-MAIL
// ============================================================

model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  usuarioId Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, expiresAt])
}

// ============================================================
// ENUMS
// ============================================================

enum TipoUsuario {
  TREINADOR
  ATLETA
}

enum Sexo {
  MASCULINO
  FEMININO
  OUTRO
  NAO_INFORMADO
}

enum StatusPartida {
  AGENDADA
  EM_ANDAMENTO
  FINALIZADA
  CANCELADA
}

enum TipoEventoAnalise {
  POSITIVA
  NEGATIVA
  NEUTRA
  DESTAQUE
}
