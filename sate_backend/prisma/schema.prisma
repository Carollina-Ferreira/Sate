generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USUÁRIO
// ============================================================

model Usuario {
  id             Int          @id @default(autoincrement())
  email          String       @unique
  senha          String
  tipo           TipoUsuario?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  nome           String?
  avatarUrl      String?      @db.LongText
  primeiroAcesso Boolean      @default(true)

  // Preserva contas existentes como verificadas.
  // O cadastro de novos usuários deve definir false explicitamente.
  emailVerificado Boolean @default(true)

  atleta                  Atleta?
  treinador               Treinador?
  preferenciasUsuario     PreferenciasUsuario?
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
}

model PreferenciasUsuario {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @unique
  email     Boolean  @default(true)
  push      Boolean  @default(true)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
}

// ============================================================
// TREINADOR
// ============================================================

model Treinador {
  id        Int      @id @default(autoincrement())
  nome      String
  usuarioId Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Informações profissionais (preenchidas no aplicativo mobile).
  formacao            String?
  registroProfissional String?
  experiencia         String?

  usuario              Usuario               @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  equipes              Equipe[]
  atletas              Atleta[]
  configuracoesAnalise ConfiguracaoAnalise[]
  notificacoes         Notificacao[]
  marcacoes            MarcacaoVideo[]
  exercicios           Exercicio[]
  treinos              Treino[]
  eventosAgenda        EventoAgenda[]

  @@index([usuarioId])
}

// ============================================================
// NOTIFICAÇÕES
// ============================================================

model Notificacao {
  id           Int       @id @default(autoincrement())
  treinadorId  Int
  tipo         String
  titulo       String
  descricao    String    @db.Text
  link         String?
  chave        String
  lida         Boolean   @default(false)
  entidadeTipo String?
  entidadeId   Int?
  resolvidaEm  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  treinador Treinador @relation(fields: [treinadorId], references: [id], onDelete: Cascade)

  @@unique([treinadorId, chave])
  @@index([treinadorId, lida, createdAt])
  @@index([treinadorId, resolvidaEm])
}

// ============================================================
// CONFIGURAÇÕES DE ANÁLISE
// ============================================================

model ConfiguracaoAnalise {
  id                Int               @id @default(autoincrement())
  nome              String
  descricao         String?
  tipo              TipoEventoAnalise @default(POSITIVA)
  ordem             Int               @default(0)
  treinadorId       Int
  equipeId          Int?
  icone             String?
  cor               String?
  mostrarNaTimeline Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  treinador Treinador @relation(fields: [treinadorId], references: [id], onDelete: Cascade)
  equipe    Equipe?   @relation(fields: [equipeId], references: [id], onDelete: Cascade)

  marcacoes MarcacaoVideo[]

  @@index([treinadorId])
  @@index([treinadorId, ordem])
  @@index([equipeId])
}

// ============================================================
// ATLETA
// ============================================================

model Atleta {
  id             Int       @id @default(autoincrement())
  nome           String?
  cpf            String?   @unique
  rg             String?
  dataNascimento DateTime?
  sexo           Sexo?
  categoria      String?
  telefone       String?
  usuarioId      Int       @unique
  responsavelId  Int?      @unique
  enderecoId     Int?      @unique
  equipeId       Int?
  treinadorId    Int?
  posicao        String?
  alturaCm       Int?
  pesoKg         Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  usuario     Usuario      @relation(fields: [usuarioId], references: [id])
  responsavel Responsavel? @relation(fields: [responsavelId], references: [id])
  endereco    Endereco?    @relation(fields: [enderecoId], references: [id])
  equipe      Equipe?      @relation(fields: [equipeId], references: [id], onDelete: SetNull)
  treinador   Treinador?   @relation(fields: [treinadorId], references: [id], onDelete: SetNull)

  documentos Documento[]

  // Partidas em que o atleta foi escalado.
  partidas PartidaAtleta[]

  // Marcações de vídeo associadas ao atleta.
  marcacoes MarcacaoVideo[]

  // Integração com o aplicativo mobile.
  treinosEspecificos TreinoAtleta[]
  presencas          Presenca[]
  testesFisicos      TesteFisico[]
  metas              MetaAtleta[]
  feedbacks          FeedbackAtleta[]
  notificacoes       NotificacaoAtleta[]

  @@index([equipeId])
  @@index([treinadorId])
}

// ============================================================
// EQUIPE
// ============================================================

model Equipe {
  id             Int       @id @default(autoincrement())
  nome           String
  modalidade     String
  categoria      String?
  proximaPartida DateTime?
  imagem         String?   @db.LongText
  corEquipe      String?
  treinadorId    Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Integração com o aplicativo mobile.
  codigoConvite String? @unique
  local         String?
  diasTreino    String? // dias da semana separados por vírgula: 1=segunda ... 7=domingo
  inicioMin     Int? // início padrão do treino, em minutos desde 00:00
  duracaoMin    Int? // duração padrão do treino, em minutos

  treinador Treinador @relation(fields: [treinadorId], references: [id], onDelete: Cascade)

  atletas              Atleta[]
  partidas             Partida[]
  configuracoesAnalise ConfiguracaoAnalise[]
  treinos              Treino[]
  eventosAgenda        EventoAgenda[]

  @@index([treinadorId], map: "Equipe_treinadorId_fkey")
}

// ============================================================
// PARTIDA
// ============================================================

model Partida {
  id             Int           @id @default(autoincrement())
  equipeId       Int
  adversario     String
  data           DateTime
  local          String?
  campeonato     String?
  rodada         String?
  observacoes    String?
  status         StatusPartida @default(AGENDADA)
  golsEquipe     Int?
  golsAdversario Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  equipe  Equipe          @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  videos  VideoPartida[]
  atletas PartidaAtleta[]

  @@index([equipeId], map: "Partida_equipeId_fkey")
  @@index([data])
}

// ============================================================
// ATLETAS ESCALADOS NA PARTIDA
// ============================================================

model PartidaAtleta {
  id        Int      @id @default(autoincrement())
  partidaId Int
  atletaId  Int
  createdAt DateTime @default(now())

  partida Partida @relation(fields: [partidaId], references: [id], onDelete: Cascade)
  atleta  Atleta  @relation(fields: [atletaId], references: [id], onDelete: Cascade)

  // Impede cadastrar o mesmo atleta duas vezes na mesma partida.
  @@unique([partidaId, atletaId])
  @@index([atletaId])
}

// ============================================================
// VÍDEOS DAS PARTIDAS
// ============================================================

model VideoPartida {
  id          Int      @id @default(autoincrement())
  partidaId   Int
  titulo      String
  nomeArquivo String
  url         String
  tipo        String?
  tamanho     Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  partida   Partida         @relation(fields: [partidaId], references: [id], onDelete: Cascade)
  marcacoes MarcacaoVideo[]
  anotacoes AnotacaoVideo[]

  @@index([partidaId], map: "VideoPartida_partidaId_fkey")
}

// ============================================================
// MARCAÇÕES DE VÍDEO
// ============================================================

model MarcacaoVideo {
  id           Int                @id @default(autoincrement())
  videoId      Int
  atletaId     Int?
  titulo       String
  categoria    String
  tempoInicio  Float
  tempoFim     Float
  observacao   String?            @db.Text
  treinadorId  Int?
  categoriaId  Int?
  avaliacao    TipoEventoAnalise?
  tipoRegistro String             @default("EVENTO")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  video        VideoPartida         @relation(fields: [videoId], references: [id], onDelete: Cascade)
  atleta       Atleta?              @relation(fields: [atletaId], references: [id], onDelete: SetNull)
  treinador    Treinador?           @relation(fields: [treinadorId], references: [id], onDelete: SetNull)
  configuracao ConfiguracaoAnalise? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)

  @@index([videoId])
  @@index([videoId, tempoInicio])
  @@index([atletaId])
  @@index([treinadorId])
  @@index([categoriaId])
}

// ============================================================
// ANOTAÇÕES E DESENHOS SOBRE VÍDEOS
// ============================================================

model AnotacaoVideo {
  id        Int      @id @default(autoincrement())
  videoId   Int
  tempo     Float
  duracao   Float    @default(5)
  formas    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  video VideoPartida @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, tempo])
}

// ============================================================
// RESPONSÁVEL DO ATLETA
// ============================================================

model Responsavel {
  id             Int      @id @default(autoincrement())
  nome           String
  grauParentesco String
  telefone       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  atleta Atleta?
}

// ============================================================
// ENDEREÇO
// ============================================================

model Endereco {
  id          Int      @id @default(autoincrement())
  cep         String
  logradouro  String
  numero      String
  bairro      String
  complemento String?
  cidade      String?
  estado      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  atleta Atleta?
}

// ============================================================
// DOCUMENTOS DO ATLETA
// ============================================================

model Documento {
  id        Int       @id @default(autoincrement())
  nome      String
  tipo      String
  url       String
  atletaId  Int
  // Metadados usados pelo aplicativo mobile (nulos/padrão para documentos já existentes).
  categoria String?
  validade  DateTime?
  aprovado  Boolean   @default(true)
  obs       String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  atleta Atleta @relation(fields: [atletaId], references: [id], onDelete: Cascade)

  @@index([atletaId], map: "Documento_atletaId_fkey")
}

// ============================================================
// RECUPERAÇÃO DE SENHA
// ============================================================

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  usuarioId Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

// ============================================================
// VERIFICAÇÃO DE E-MAIL
// ============================================================

model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  usuarioId Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, expiresAt])
}

// ============================================================
// INTEGRAÇÃO MOBILE — EXERCÍCIOS, TREINOS, FREQUÊNCIA, TESTES,
// AGENDA, METAS, FEEDBACKS E NOTIFICAÇÕES DO ATLETA
// ============================================================

model Exercicio {
  id          Int      @id @default(autoincrement())
  treinadorId Int
  nome        String
  grupo       String   @default("Geral")
  series      Int      @default(3)
  repeticoes  Int      @default(10)
  duracaoSeg  Int      @default(0)
  instrucoes  String?  @db.Text
  video       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  treinador Treinador @relation(fields: [treinadorId], references: [id], onDelete: Cascade)

  @@index([treinadorId])
}

model Treino {
  id          Int      @id @default(autoincrement())
  equipeId    Int
  treinadorId Int
  titulo      String
  objetivo    String?
  foco        String?
  observacoes String?  @db.Text
  data        DateTime @db.Date
  inicioMin   Int      @default(1080)
  duracaoMin  Int      @default(60)
  // Lista (JSON) com os ids dos exercícios do treino.
  exercicios  String?  @db.Text
  // Preenchido quando o treino altera/cancela uma sessão recorrente da equipe.
  padraoChave String?
  cancelado   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  equipe    Equipe        @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  treinador Treinador     @relation(fields: [treinadorId], references: [id], onDelete: Cascade)
  atletas   TreinoAtleta[]

  @@unique([equipeId, padraoChave])
  @@index([equipeId, data])
  @@index([treinadorId])
}

// Sem registros = o treino vale para toda a equipe.
model TreinoAtleta {
  id       Int @id @default(autoincrement())
  treinoId Int
  atletaId Int

  treino Treino @relation(fields: [treinoId], references: [id], onDelete: Cascade)
  atleta Atleta @relation(fields: [atletaId], references: [id], onDelete: Cascade)

  @@unique([treinoId, atletaId])
  @@index([atletaId])
}

model Presenca {
  id        Int      @id @default(autoincrement())
  atletaId  Int
  data      DateTime @db.Date
  presente  Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  atleta Atleta @relation(fields: [atletaId], references: [id], onDelete: Cascade)

  @@unique([atletaId, data])
  @@index([data])
}

model TesteFisico {
  id             Int      @id @default(autoincrement())
  atletaId       Int
  teste          String
  unidade        String
  valor          Float
  data           DateTime
  obs            String?  @db.Text
  registradoPor  String   @default("TREINADOR") // TREINADOR ou ATLETA
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  atleta Atleta @relation(fields: [atletaId], references: [id], onDelete: Cascade)

  @@index([atletaId, teste, data])
}

model EventoAgenda {
  id          Int      @id @default(autoincrement())
  treinadorId Int
  // Nulo = vale para todas as equipes do treinador.
  equipeId    Int?
  titulo      String
  tipo        String   @default("LEMBRETE") // JOGO, AVALIACAO, REUNIAO, LEMBRETE
  local       String?
  observacoes String?  @db.Text
  data        DateTime @db.Date
  inicioMin   Int      @default(480)
  fimMin      Int      @default(540)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  treinador Treinador @relation(fields: [treinadorId], references: [id], onDelete: Cascade)
  equipe    Equipe?   @relation(fields: [equipeId], references: [id], onDelete: Cascade)

  @@index([treinadorId, data])
  @@index([equipeId])
}

model MetaAtleta {
  id        Int      @id @default(autoincrement())
  atletaId  Int
  titulo    String
  descricao String?  @db.Text
  progresso Int      @default(0)
  prazo     DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  atleta Atleta @relation(fields: [atletaId], references: [id], onDelete: Cascade)

  @@index([atletaId])
}

model FeedbackAtleta {
  id        Int      @id @default(autoincrement())
  atletaId  Int
  texto     String   @db.Text
  createdAt DateTime @default(now())

  atleta Atleta @relation(fields: [atletaId], references: [id], onDelete: Cascade)

  @@index([atletaId, createdAt])
}

// Equivalente de Notificacao (que pertence ao treinador) para o atleta.
model NotificacaoAtleta {
  id           Int      @id @default(autoincrement())
  atletaId     Int
  tipo         String
  titulo       String
  descricao    String   @db.Text
  link         String?
  chave        String
  lida         Boolean  @default(false)
  entidadeTipo String?
  entidadeId   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  atleta Atleta @relation(fields: [atletaId], references: [id], onDelete: Cascade)

  @@unique([atletaId, chave])
  @@index([atletaId, lida, createdAt])
}

// ============================================================
// ENUMS
// ============================================================

enum TipoUsuario {
  TREINADOR
  ATLETA
}

enum Sexo {
  MASCULINO
  FEMININO
  OUTRO
  NAO_INFORMADO
}

enum StatusPartida {
  AGENDADA
  EM_ANDAMENTO
  FINALIZADA
  CANCELADA
}

enum TipoEventoAnalise {
  POSITIVA
  NEGATIVA
  NEUTRA
  DESTAQUE
}
