generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                  Int                  @id @default(autoincrement())
  email               String               @unique
  senha               String
  tipo                TipoUsuario?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  nome                String?
  avatarUrl           String?              @db.LongText
  primeiroAcesso      Boolean              @default(true)
  atleta              Atleta?
  passwordResetTokens PasswordResetToken[]
  treinador           Treinador?
}

model Treinador {
  id        Int      @id @default(autoincrement())
  nome      String
  usuarioId Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  atletas   Atleta[]
  equipes   Equipe[]
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Atleta {
  id             Int          @id @default(autoincrement())
  nome           String?
  cpf            String?      @unique
  rg             String?
  dataNascimento DateTime?
  sexo           Sexo?
  categoria      String?
  telefone       String?
  usuarioId      Int          @unique
  responsavelId  Int?         @unique
  enderecoId     Int?         @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  equipeId       Int?
  treinadorId    Int?
  endereco       Endereco?    @relation(fields: [enderecoId], references: [id])
  equipe         Equipe?      @relation(fields: [equipeId], references: [id])
  responsavel    Responsavel? @relation(fields: [responsavelId], references: [id])
  treinador      Treinador?   @relation(fields: [treinadorId], references: [id])
  usuario        Usuario      @relation(fields: [usuarioId], references: [id])
  documentos     Documento[]

  @@index([equipeId])
  @@index([treinadorId])
}

model Equipe {
  id             Int       @id @default(autoincrement())
  nome           String
  modalidade     String
  categoria      String?
  proximaPartida DateTime?
  imagem         String?
  corEquipe      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  treinadorId    Int
  atletas        Atleta[]
  treinador      Treinador @relation(fields: [treinadorId], references: [id], onDelete: Cascade)
  partidas       Partida[]

  @@index([treinadorId], map: "Equipe_treinadorId_fkey")
}

model Partida {
  id             Int           @id @default(autoincrement())
  equipeId       Int
  adversario     String
  data           DateTime
  local          String?
  campeonato     String?
  rodada         String?
  observacoes    String?
  status         StatusPartida @default(AGENDADA)
  golsEquipe     Int?
  golsAdversario Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  equipe         Equipe        @relation(fields: [equipeId], references: [id], onDelete: Cascade)

  @@index([equipeId], map: "Partida_equipeId_fkey")
  @@index([data])
}

model Responsavel {
  id             Int      @id @default(autoincrement())
  nome           String
  grauParentesco String
  telefone       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  atleta         Atleta?
}

model Endereco {
  id          Int      @id @default(autoincrement())
  cep         String
  logradouro  String
  numero      String
  bairro      String
  complemento String?
  cidade      String?
  estado      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  atleta      Atleta?
}

model Documento {
  id        Int      @id @default(autoincrement())
  nome      String
  tipo      String
  url       String
  atletaId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  atleta    Atleta   @relation(fields: [atletaId], references: [id], onDelete: Cascade)

  @@index([atletaId], map: "Documento_atletaId_fkey")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  usuarioId Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId], map: "PasswordResetToken_usuarioId_fkey")
}

enum TipoUsuario {
  TREINADOR
  ATLETA
}

enum Sexo {
  MASCULINO
  FEMININO
  OUTRO
  NAO_INFORMADO
}

enum StatusPartida {
  AGENDADA
  EM_ANDAMENTO
  FINALIZADA
  CANCELADA
}
